# Session signing (required in production and preview)
SESSION_SECRET=at_least_32_characters_long_random_string

# Admin cookie for export/delete (required for admin on production/preview)
LV_ADMIN_SECRET=another_long_random_string_for_admin

# Vercel Cron authorization (required for /api/cron/* in production).
# Set the same value in the Vercel project → Settings → Environment Variables.
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
# Never use NEXT_PUBLIC_CRON_SECRET.
CRON_SECRET=long_random_string_for_cron_only

# Photon / Spectrum cloud iMessage (server-only — never NEXT_PUBLIC_*).
# Free/Pro shared-pool DMs (no dedicated number). Both recipients get individual DMs.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Production Daily Summary iMessage recipients (Derek + Dad).
DAILY_SUMMARY_DEREK_PHONE=+1XXXXXXXXXX
DAILY_SUMMARY_DAD_PHONE=+1XXXXXXXXXX

# Optional: password required when employee selects "Derek Thach" on check-in (default 1225)
# STAFF_DEREK_PASSWORD=1225

# Optional: local dev
# NODE_ENV=development
# GOOGLE_CLOUD_PROJECT=lindavista-hms
# GOOGLE_APPLICATION_CREDENTIALS=./lindavista-hms-sa.json
