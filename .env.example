# Copy to .env.local and fill in values. Do not commit .env.local.

# Firebase Admin (required for dashboard, check-ins, and Firestore)
# Option A: Full service account JSON (single line or escaped)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project",...}

# Option B: Split credentials (no JSON in env)
# GOOGLE_CLOUD_PROJECT=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# If neither A nor B is set, the app uses Application Default Credentials (gcloud).
# If you see "invalid_grant" or "invalid_rapt" locally, run: gcloud auth application-default login
# or add Option A/B above.

# Session secret (iron-session) — required in production (e.g. Vercel). Must be at least 32 characters.
# SESSION_SECRET=at-least-32-characters-secret

# Optional: admin cookie for LV
# LV_ADMIN_SECRET=your-admin-secret
